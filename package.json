{
  "name": "uruntipiappstore",
  "version": "1.0.0",
  "description": "Automated UmbrelOS App Store Port for Runtipi",
  "type": "module",
  "scripts": {
    "sync": "node --experimental-strip-types scripts/sync-umbrel.ts",
    "update:blacklist": "node --experimental-strip-types scripts/update-blacklist.ts",
    "validate:json": "node scripts/validate-json.js",
    "test:unit": "vitest run scripts/__tests__/transpiler.test.ts",
    "test:apps": "vitest run apps/__tests__/apps.test.ts apps/__tests__/umbrel-port.test.ts",
    "test": "vitest run scripts/__tests__ apps/__tests__ && node scripts/validate-json.js",
    "lint": "biome check scripts apps/__tests__"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@runtipi/common": "^1.1.3",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.0",
    "sharp": "^0.33.5",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
