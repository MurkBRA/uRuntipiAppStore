{
  "schemaVersion": 2,
  "services": [
    {
      "name": "pyload-ng",
      "image": "linuxserver/pyload-ng:0.5.0",
      "isMain": true,
      "internalPort": 8000,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "Etc/UTC"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/downloads",
          "containerPath": "/downloads"
        }
      ]
    }
  ]
}
