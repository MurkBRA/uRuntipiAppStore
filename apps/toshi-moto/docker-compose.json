{
  "schemaVersion": 2,
  "services": [
    {
      "name": "toshi-moto",
      "image": "toshimoto821/toshi-moto:1.37.3",
      "isMain": true,
      "internalPort": 8021,
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "PORT",
          "value": 8021
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/proxy/nginx.conf",
          "containerPath": "/etc/nginx/conf.d/default.conf",
          "readOnly": true
        }
      ],
      "dependsOn": [
        "toshi-moto-api_web"
      ]
    },
    {
      "name": "toshi-moto-api_web",
      "image": "toshimoto821/toshi-moto-api:1.8.4",
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "PORT",
          "value": 8121
        },
        {
          "key": "MONGODB_URI",
          "value": "mongodb://toshi-moto-mongodb:27017/toshi-moto"
        }
      ],
      "dependsOn": [
        "toshi-moto-mongodb"
      ]
    },
    {
      "name": "toshi-moto-mongodb",
      "image": "mongo:8.0.10",
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "command": "mongod --noauth",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/data/db"
        }
      ]
    }
  ]
}
