{
  "schemaVersion": 2,
  "services": [
    {
      "name": "simple-torrent",
      "image": "boypt/cloud-torrent:1.3.9",
      "isMain": true,
      "internalPort": 8086,
      "user": "1000:1000",
      "command": "--port=8086 --config-path /config/simple-torrent.json",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/torrents",
          "containerPath": "/torrents"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/downloads",
          "containerPath": "/downloads"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        }
      ]
    }
  ]
}
