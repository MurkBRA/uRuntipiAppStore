{
  "schemaVersion": 2,
  "services": [
    {
      "name": "public-pool",
      "image": "nginx:1.25.3",
      "isMain": true,
      "internalPort": 80,
      "addToMainNetwork": true,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/proxy/nginx.conf",
          "containerPath": "/etc/nginx/conf.d/default.conf",
          "readOnly": true
        }
      ],
      "dependsOn": [
        "public-pool-web",
        "public-pool-server"
      ]
    },
    {
      "name": "public-pool-web",
      "image": "ghcr.io/benjamin-wilson/public-pool-ui:5f730f4",
      "addToMainNetwork": true,
      "stopGracePeriod": "30s",
      "environment": [
        {
          "key": "DOMAIN",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "PUBLIC_POOL_STRATUM_URL",
          "value": "${APP_DOMAIN}:2018"
        }
      ]
    },
    {
      "name": "public-pool-server",
      "image": "ghcr.io/benjamin-wilson/public-pool:95565ee",
      "addToMainNetwork": true,
      "stopGracePeriod": "30s",
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "BITCOIN_RPC_URL",
          "value": "http://${APP_BITCOIN_NODE_IP}"
        },
        {
          "key": "BITCOIN_RPC_USER",
          "value": "${APP_BITCOIN_RPC_USER}"
        },
        {
          "key": "BITCOIN_RPC_PASSWORD",
          "value": "${APP_BITCOIN_RPC_PASS}"
        },
        {
          "key": "BITCOIN_RPC_PORT",
          "value": "${APP_BITCOIN_RPC_PORT}"
        },
        {
          "key": "BITCOIN_RPC_TIMEOUT",
          "value": "10000"
        },
        {
          "key": "API_PORT",
          "value": "2019"
        },
        {
          "key": "STRATUM_PORT",
          "value": "2018"
        },
        {
          "key": "NETWORK",
          "value": "mainnet"
        },
        {
          "key": "API_SECURE",
          "value": "false"
        },
        {
          "key": "ENABLE_SOLO",
          "value": "true"
        },
        {
          "key": "ENABLE_PROXY",
          "value": "false"
        },
        {
          "key": "POOL_IDENTIFIER",
          "value": "\"Public Pool on Umbrel\""
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/database",
          "containerPath": "/public-pool/DB"
        }
      ],
      "addPorts": [
        {
          "hostPort": 2018,
          "containerPort": 2018,
          "tcp": true
        }
      ]
    }
  ]
}
