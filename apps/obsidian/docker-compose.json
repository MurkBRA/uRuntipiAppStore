{
  "schemaVersion": 2,
  "services": [
    {
      "name": "obsidian",
      "image": "linuxserver/obsidian:1.8.10",
      "isMain": true,
      "internalPort": 3000,
      "shmSize": "1gb",
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        }
      ]
    }
  ]
}
