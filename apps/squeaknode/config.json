      "min": 32,
      "env_variable": "APP_SQUEAKNODE_P2P_HIDDEN_SERVICE"
    },
    {
      "type": "text",
      "label": "Bitcoin Node Host / IP",
      "required": false,
      "default": "bitcoind",
      "hint": "Hostname or IP of your Bitcoin RPC node on the Runtipi network",
      "env_variable": "APP_BITCOIN_NODE_IP"
    },
    {
      "type": "number",
      "label": "Bitcoin RPC Port",
      "required": false,
      "default": 8332,
      "env_variable": "APP_BITCOIN_RPC_PORT"
    },
    {
      "type": "text",
      "label": "Bitcoin RPC Username",
      "required": false,
      "default": "umbrel",
      "env_variable": "APP_BITCOIN_RPC_USER"
    },
    {
      "type": "password",
      "label": "Bitcoin RPC Password",
      "required": false,
      "default": "moneyprintergobrrr",
      "env_variable": "APP_BITCOIN_RPC_PASS"
    },
    {
      "type": "text",
      "label": "Lightning (LND) Node Host / IP",
      "required": false,
      "default": "lightning",
      "env_variable": "APP_LIGHTNING_NODE_IP"
    },
    {
      "type": "number",
      "label": "Lightning (LND) gRPC Port",
      "required": false,
      "default": 10009,
      "env_variable": "APP_LIGHTNING_NODE_GRPC_PORT"
    },
    {
      "type": "text",
      "label": "Bitcoin Network",
