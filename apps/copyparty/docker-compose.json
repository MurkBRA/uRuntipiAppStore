{
  "schemaVersion": 2,
  "services": [
    {
      "name": "copyparty",
      "image": "ghcr.io/9001/copyparty-ac:1.20.26",
      "isMain": true,
      "internalPort": 3923,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "TZ",
          "value": "UTC"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config/config.conf",
          "containerPath": "/cfg/config.conf",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/cp_data",
          "containerPath": "/cfg/hists"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/shared",
          "containerPath": "/shr"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/media",
          "containerPath": "/media"
        }
      ]
    }
  ]
}
