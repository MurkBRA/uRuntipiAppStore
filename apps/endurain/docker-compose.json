{
  "schemaVersion": 2,
  "services": [
    {
      "name": "endurain",
      "image": "ghcr.io/endurain-project/endurain:v0.20.1",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "DB_TYPE",
          "value": "postgres"
        },
        {
          "key": "DB_HOST",
          "value": "endurain-db"
        },
        {
          "key": "DB_PORT",
          "value": 5432
        },
        {
          "key": "DB_PASSWORD",
          "value": "endurain"
        },
        {
          "key": "SECRET_KEY",
          "value": "${APP_SECRET_KEY:-${APP_PASSWORD}}"
        },
        {
          "key": "BEHIND_PROXY",
          "value": "true"
        },
        {
          "key": "TRUSTED_PROXIES",
          "value": "${INTERNAL_IP}/16"
        },
        {
          "key": "DEPLOYMENT_PROFILE",
          "value": "local"
        },
        {
          "key": "WEB_WORKERS",
          "value": 1
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/app/backend/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/logs",
          "containerPath": "/app/backend/logs"
        }
      ],
      "dependsOn": {
        "endurain-db": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "endurain-db",
      "image": "postgres:17.4",
      "environment": [
        {
          "key": "POSTGRES_PASSWORD",
          "value": "endurain"
        },
        {
          "key": "POSTGRES_DB",
          "value": "endurain"
        },
        {
          "key": "POSTGRES_USER",
          "value": "endurain"
        },
        {
          "key": "PGDATA",
          "value": "/var/lib/postgresql/data/pgdata"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U endurain",
        "interval": "5s",
        "timeout": "5s",
        "retries": 5
      }
    }
  ]
}
