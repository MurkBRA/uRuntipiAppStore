{
  "name": "Agora",
  "available": true,
  "port": 12080,
  "exposable": true,
  "dynamic_config": true,
  "id": "agora",
  "description": "Agora is a project that allows anyone to sell files on the web for bitcoin using the Lightning Network.",
  "tipi_version": 1,
  "version": "1.19-alpine",
  "categories": [
    "utilities",
    "data"
  ],
  "short_desc": "Sell your files for Bitcoin",
  "author": "Casey Rodarmor & Sönke Hahn",
  "source": "https://github.com/agora-org/agora",
  "website": "https://agora-org.github.io/agora/",
  "url_suffix": "/admin/",
  "uid": 1000,
  "gid": 1000,
  "form_fields": [
    {
      "type": "text",
      "label": "Container User (UID:GID)",
      "hint": "Process user and group ID (UID:GID). Keep 1000:1000 unless custom host permissions are required.",
      "required": false,
      "default": "1000:1000",
      "regex": "^[0-9]+(:[0-9]+)?$",
      "pattern_error": "Must be a numeric UID:GID (e.g. 1000:1000) or numeric UID (e.g. 1000)",
      "env_variable": "APP_CONTAINER_USER"
    },
    {
      "type": "random",
      "label": "Agora password",
      "min": 32,
      "env_variable": "APP_PASSWORD"
    },
    {
      "type": "text",
      "label": "Lightning (LND) Node Host / IP",
      "required": false,
      "default": "lightning",
      "env_variable": "APP_LIGHTNING_NODE_IP"
    },
    {
      "type": "number",
      "label": "Lightning (LND) gRPC Port",
      "required": false,
      "default": 10009,
      "env_variable": "APP_LIGHTNING_NODE_GRPC_PORT"
    },
    {
      "type": "text",
      "label": "Bitcoin Network",
      "required": false,
      "default": "mainnet",
      "hint": "Network mode for Bitcoin node (mainnet, testnet, signet, regtest)",
      "env_variable": "APP_BITCOIN_NETWORK"
    },
    {
      "type": "text",
      "label": "Lightning (LND) Data Directory",
      "required": false,
      "default": "/data/lnd",
      "env_variable": "APP_LIGHTNING_NODE_DATA_DIR"
    }
  ],
  "supported_architectures": [
    "arm64",
    "amd64"
  ],
  "created_at": 1792501487865,
  "updated_at": 1792501547865,
  "$schema": "../app-info-schema.json",
  "min_tipi_version": "4.7.0"
}
