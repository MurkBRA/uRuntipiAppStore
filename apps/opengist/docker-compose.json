{
  "schemaVersion": 2,
  "services": [
    {
      "name": "opengist",
      "image": "ghcr.io/thomiceli/opengist:1.15.3",
      "isMain": true,
      "internalPort": 6157,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "OG_SSH_PORT",
          "value": "2224"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/opengist"
        }
      ],
      "addPorts": [
        {
          "hostPort": 2224,
          "containerPort": 2224,
          "tcp": true
        }
      ]
    }
  ]
}
