{
  "schemaVersion": 2,
  "services": [
    {
      "name": "glasshome",
      "image": "ghcr.io/glasshome/dash:1.4.5",
      "isMain": true,
      "internalPort": 3123,
      "environment": [
        {
          "key": "PORT",
          "value": 3123
        },
        {
          "key": "DATA_DIR",
          "value": "/data"
        },
        {
          "key": "TRUSTED_PROXIES",
          "value": "127.0.0.0/8,::1,${GATEWAY_IP}/32"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
