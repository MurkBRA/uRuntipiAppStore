{
  "schemaVersion": 2,
  "services": [
    {
      "name": "circuitbreaker",
      "image": "ghcr.io/lightningequipment/circuitbreaker:v0.5.1",
      "isMain": true,
      "internalPort": 9235,
      "addToMainNetwork": true,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "command": [
        "--configdir=/data/.circuitbreaker",
        "--network=${APP_BITCOIN_NETWORK}",
        "--lnddir=/data/.lnd",
        "--rpcserver=${APP_LIGHTNING_NODE_IP}:${APP_LIGHTNING_NODE_GRPC_PORT}",
        "--httplisten=0.0.0.0:9235"
      ],
      "volumes": [
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}",
          "containerPath": "/data/.lnd",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data/.circuitbreaker"
        }
      ]
    }
  ]
}
