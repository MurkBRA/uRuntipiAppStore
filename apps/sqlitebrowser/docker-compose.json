{
  "schemaVersion": 2,
  "services": [
    {
      "name": "sqlitebrowser",
      "image": "linuxserver/sqlitebrowser:3.13.1",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        },
        {
          "key": "TZ",
          "value": "Etc/CET"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        }
      ]
    }
  ]
}
