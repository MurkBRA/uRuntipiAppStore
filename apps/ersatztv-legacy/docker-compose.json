{
  "schemaVersion": 2,
  "services": [
    {
      "name": "ersatztv-legacy",
      "image": "ghcr.io/ersatztv/legacy:v26.11.3",
      "isMain": true,
      "internalPort": 8409,
      "user": "1000:1000",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/transcode",
          "containerPath": "/transcode"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/downloads",
          "containerPath": "/media",
          "readOnly": true
        }
      ]
    }
  ]
}
