{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bitcoin-regtest-dashboard",
      "image": "coreylphillips/bitcoin-regtest-dashboard:v1.1.0",
      "isMain": true,
      "internalPort": 3000,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "PORT",
          "value": 3000
        },
        {
          "key": "BITCOIN_RPC_HOST",
          "value": "bitcoin-regtest-dashboard-bitcoin"
        },
        {
          "key": "BITCOIN_RPC_PORT",
          "value": 18443
        },
        {
          "key": "BITCOIN_COOKIE_FILE",
          "value": "/bitcoin/.bitcoin/regtest/.cookie"
        },
        {
          "key": "ELECTRS_HOST",
          "value": "bitcoin-regtest-dashboard-electrs"
        },
        {
          "key": "ELECTRS_PORT",
          "value": 50001
        },
        {
          "key": "ELECTRS_EXTERNAL_PORT",
          "value": 60401
        },
        {
          "key": "BITCOIN_DEBUG_LOG",
          "value": "/bitcoin/.bitcoin/regtest/debug.log"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/bitcoin",
          "containerPath": "/bitcoin/.bitcoin",
          "readOnly": true
        }
      ],
      "dependsOn": {
        "bitcoin-regtest-dashboard-bitcoin": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "bitcoin-regtest-dashboard-bitcoin",
      "image": "ghcr.io/getumbrel/docker-bitcoind:v31.1",
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "command": [
        "rm -f /data/.bitcoin/regtest/.ready\nbitcoind -regtest \\\n  -server=1 \\\n  -rpcbind=0.0.0.0 \\\n  -rpcallowip=0.0.0.0/0 \\\n  -rpcport=18443 \\\n  -txindex=1 \\\n  -fallbackfee=0.00001 \\\n  -disablewallet=0 \\\n  -zmqpubrawblock=tcp://0.0.0.0:28332 \\\n  -zmqpubrawtx=tcp://0.0.0.0:28333 &\nBITCOIND_PID=$$!\nwhile [ ! -f /data/.bitcoin/regtest/.cookie ]; do sleep 1; done\nchmod 755 /data/.bitcoin/regtest\nchmod 644 /data/.bitcoin/regtest/.cookie\nchmod 644 /data/.bitcoin/regtest/debug.log 2>/dev/null || true\nsleep 2\nbitcoin-cli -regtest -rpccookiefile=/data/.bitcoin/regtest/.cookie createwallet \"regtest_wallet\" 2>/dev/null || \\\n  bitcoin-cli -regtest -rpccookiefile=/data/.bitcoin/regtest/.cookie loadwallet \"regtest_wallet\" 2>/dev/null || true\nbitcoin-cli -regtest -rpccookiefile=/data/.bitcoin/regtest/.cookie -rpcwallet=regtest_wallet -generate 1 >/dev/null 2>&1 || true\ntouch /data/.bitcoin/regtest/.ready\nwhile kill -0 $$BITCOIND_PID 2>/dev/null; do\n  chmod 755 /data/.bitcoin/regtest 2>/dev/null\n  chmod 644 /data/.bitcoin/regtest/.cookie 2>/dev/null\n  chmod 644 /data/.bitcoin/regtest/debug.log 2>/dev/null\n  sleep 5\ndone &\nwait $$BITCOIND_PID\n"
      ],
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/bitcoin",
          "containerPath": "/data/.bitcoin"
        }
      ],
      "healthCheck": {
        "test": "test -f /data/.bitcoin/regtest/.ready && chmod 644 /data/.bitcoin/regtest/.cookie && bitcoin-cli -regtest -rpccookiefile=/data/.bitcoin/regtest/.cookie getblockchaininfo",
        "interval": "5s",
        "timeout": "5s",
        "retries": 10,
        "startPeriod": "10s"
      }
    },
    {
      "name": "bitcoin-regtest-dashboard-electrs",
      "image": "getumbrel/electrs:v0.11.0",
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "ELECTRS_ELECTRUM_RPC_ADDR",
          "value": "0.0.0.0:50001"
        },
        {
          "key": "ELECTRS_DAEMON_RPC_ADDR",
          "value": "bitcoin-regtest-dashboard-bitcoin:18443"
        },
        {
          "key": "ELECTRS_DAEMON_P2P_ADDR",
          "value": "bitcoin-regtest-dashboard-bitcoin:18444"
        },
        {
          "key": "ELECTRS_LOG_FILTERS",
          "value": "INFO"
        },
        {
          "key": "ELECTRS_NETWORK",
          "value": "regtest"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/electrs",
          "containerPath": "/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/bitcoin",
          "containerPath": "/data/.bitcoin",
          "readOnly": true
        }
      ],
      "addPorts": [
        {
          "hostPort": 60401,
          "containerPort": 50001,
          "tcp": true
        }
      ],
      "dependsOn": {
        "bitcoin-regtest-dashboard-bitcoin": {
          "condition": "service_healthy"
        }
      }
    }
  ]
}
