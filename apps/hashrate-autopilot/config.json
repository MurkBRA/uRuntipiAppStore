  "author": "Remco Douma",
  "source": "https://github.com/rdouma/hashrate-autopilot",
  "website": "https://github.com/rdouma/hashrate-autopilot",
  "form_fields": [
    {
      "type": "text",
      "label": "Bitcoin Node Host / IP",
      "required": false,
      "default": "bitcoind",
      "hint": "Hostname or IP of your Bitcoin RPC node on the Runtipi network",
      "env_variable": "APP_BITCOIN_NODE_IP"
    },
    {
      "type": "number",
      "label": "Bitcoin RPC Port",
      "required": false,
      "default": 8332,
      "env_variable": "APP_BITCOIN_RPC_PORT"
    },
    {
      "type": "text",
      "label": "Bitcoin RPC Username",
      "required": false,
      "default": "umbrel",
      "env_variable": "APP_BITCOIN_RPC_USER"
    },
    {
      "type": "password",
      "label": "Bitcoin RPC Password",
      "required": false,
      "default": "moneyprintergobrrr",
      "env_variable": "APP_BITCOIN_RPC_PASS"
    },
    {
      "type": "text",
      "label": "Electrs Server Host / IP",
      "required": false,
      "default": "electrs",
      "env_variable": "APP_ELECTRS_NODE_IP"
    },
    {
      "type": "number",
      "label": "Electrs Server Port",
      "required": false,
      "default": 50001,
      "env_variable": "APP_ELECTRS_NODE_PORT"
    },
    {
      "type": "random",
      "label": "Hashrate Autopilot seed",
      "min": 64,
      "encoding": "hex",
      "env_variable": "APP_SEED"
    }
  ],
  "supported_architectures": [
    "arm64",
    "amd64"
  ],
