{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bitcoin-knots",
      "image": "ghcr.io/retropex/umbrel-bitcoin-knots:1.2.13",
      "isMain": true,
      "internalPort": 3000,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "15m30s",
      "environment": [
        {
          "key": "BITCOIND_EXTRA_ARGS",
          "value": "-deprecatedrpc=create_bdb"
        },
        {
          "key": "APPS_SUBNET",
          "value": "${INTERNAL_IP}/16"
        },
        {
          "key": "P2P_PORT",
          "value": "9333"
        },
        {
          "key": "P2P_WHITEBIND_PORT",
          "value": "9335"
        },
        {
          "key": "RPC_PORT",
          "value": "9332"
        },
        {
          "key": "TOR_PORT",
          "value": "8334"
        },
        {
          "key": "ZMQ_RAWBLOCK_PORT",
          "value": "48332"
        },
        {
          "key": "ZMQ_RAWTX_PORT",
          "value": "48333"
        },
        {
          "key": "ZMQ_HASHBLOCK_PORT",
          "value": "48334"
        },
        {
          "key": "ZMQ_SEQUENCE_PORT",
          "value": "48335"
        },
        {
          "key": "ZMQ_HASHTX_PORT",
          "value": "48336"
        },
        {
          "key": "TOR_HOST",
          "value": "10.21.22.12"
        },
        {
          "key": "TOR_SOCKS_PORT",
          "value": "9050"
        },
        {
          "key": "TOR_CONTROL_PORT",
          "value": "9051"
        },
        {
          "key": "TOR_CONTROL_PASSWORD",
          "value": "moneyprintergobrrr"
        },
        {
          "key": "I2P_HOST",
          "value": "bitcoin-knots-i2pd_daemon"
        },
        {
          "key": "I2P_SAM_PORT",
          "value": "7656"
        },
        {
          "key": "BITCOIND_IP",
          "value": "bitcoin-knots"
        },
        {
          "key": "RPC_USER",
          "value": "${APP_BITCOIN_KNOTS_RPC_USER}"
        },
        {
          "key": "RPC_PASS",
          "value": "${APP_BITCOIN_KNOTS_RPC_PASS}"
        },
        {
          "key": "DEVICE_DOMAIN_NAME",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "P2P_HIDDEN_SERVICE",
          "value": "${APP_BITCOIN_KNOTS_P2P_HIDDEN_SERVICE}"
        },
        {
          "key": "RPC_HIDDEN_SERVICE",
          "value": "${APP_BITCOIN_KNOTS_RPC_HIDDEN_SERVICE}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "addPorts": [
        {
          "hostPort": 9333,
          "containerPort": 9333,
          "tcp": true
        },
        {
          "hostPort": 9332,
          "containerPort": 9332,
          "tcp": true
        }
      ]
    },
    {
      "name": "bitcoin-knots-i2pd_daemon",
      "image": "purplei2p/i2pd:release-2.59.0",
      "user": "root",
      "command": "--sam.enabled=true --sam.address=0.0.0.0 --sam.port=7656 --loglevel=error",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/i2pd",
          "containerPath": "/home/i2pd/data"
        }
      ]
    }
  ]
}
