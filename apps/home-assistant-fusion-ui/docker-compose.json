{
  "schemaVersion": 2,
  "services": [
    {
      "name": "home-assistant-fusion-ui",
      "image": "ghcr.io/matt8707/ha-fusion:2024.10.1",
      "isMain": true,
      "internalPort": 5023,
      "addToMainNetwork": true,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "HASS_URL",
          "value": "${HASS_URL:-http://host.docker.internal:8123}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/fusion",
          "containerPath": "/app/data"
        }
      ],
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ]
    }
  ]
}
