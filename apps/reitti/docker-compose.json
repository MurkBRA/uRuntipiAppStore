{
  "schemaVersion": 2,
  "services": [
    {
      "name": "reitti",
      "image": "dedicatedcode/reitti:5.8.0",
      "isMain": true,
      "internalPort": 8080,
      "environment": [
        {
          "key": "POSTGIS_USER",
          "value": "reitti"
        },
        {
          "key": "POSTGIS_PASSWORD",
          "value": "reitti"
        },
        {
          "key": "POSTGIS_DB",
          "value": "reittidb"
        },
        {
          "key": "POSTGIS_HOST",
          "value": "reitti-postgis"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/data"
        }
      ],
      "dependsOn": {
        "reitti-postgis": {
          "condition": "service_healthy"
        },
        "reitti-redis": {
          "condition": "service_healthy"
        },
        "reitti-tile-cache": {
          "condition": "service_healthy"
        }
      }
    },
    {
      "name": "reitti-postgis",
      "image": "imresamu/postgis:17-3.5-alpine",
      "environment": [
        {
          "key": "POSTGRES_USER",
          "value": "reitti"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "reitti"
        },
        {
          "key": "POSTGRES_DB",
          "value": "reittidb"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/postgis",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U reitti -d reittidb",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "reitti-redis",
      "image": "redis:7.4.9-alpine",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/redis",
          "containerPath": "/data"
        }
      ],
      "healthCheck": {
        "test": "redis-cli ping",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    {
      "name": "reitti-tile-cache",
      "image": "dedicatedcode/reitti-tile-cache:5.8.0",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/title-cache",
          "containerPath": "/var/cache/nginx"
        }
      ],
      "healthCheck": {
        "test": "curl -f -s -o /dev/null -H \"X-Reitti-Upstream-Url: https://tiles.dedicatedcode.com\" http://localhost/custom/planet/latest/0/0/0.pbf || exit 1",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5,
        "startPeriod": "5s"
      }
    }
  ]
}
