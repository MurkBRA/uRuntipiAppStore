{
  "schemaVersion": 2,
  "services": [
    {
      "name": "sikka",
      "image": "ghcr.io/sikkalabs/sikka:0.2.0",
      "isMain": true,
      "internalPort": 64552,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/home/sikka/data"
        }
      ]
    }
  ]
}
