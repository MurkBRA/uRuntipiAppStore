{
  "schemaVersion": 2,
  "services": [
    {
      "name": "snowflake",
      "image": "sorenisanerd/gotty:v1.6.0",
      "isMain": true,
      "internalPort": 3800,
      "stopGracePeriod": "1m",
      "command": "gotty --port 3800 --index \"/snowflake/index.html\" --title-format \"Tor Snowflake Proxy\" bash -c 'tail -n 10000 -f /snowflake/snowflake.log | grep \"Traffic Relayed\"'",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/snowflake"
        }
      ]
    },
    {
      "name": "snowflake-proxy",
      "image": "thetorproject/snowflake-proxy:v2.15.2",
      "stopGracePeriod": "1m",
      "command": "-log /data/snowflake.log -verbose",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
