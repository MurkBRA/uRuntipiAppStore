{
  "schemaVersion": 2,
  "services": [
    {
      "name": "trip",
      "image": "ghcr.io/itskovacs/trip:1.50.1",
      "isMain": true,
      "internalPort": 8000,
      "stopGracePeriod": "1m",
      "command": [
        "fastapi",
        "run",
        "/app/trip/main.py",
        "--host",
        "0.0.0.0"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/app/storage"
        }
      ]
    }
  ]
}
