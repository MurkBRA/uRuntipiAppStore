{
  "schemaVersion": 2,
  "services": [
    {
      "name": "dcrdex",
      "image": "decred/dcrdex:v1.0.5",
      "isMain": true,
      "internalPort": 5758,
      "user": "1000:1000",
      "stopGracePeriod": "15m",
      "entrypoint": [
        "/bin/sh",
        "-c",
        "exec ./bisonw --webaddr $(hostname -I|cut -d\\  -f1 ):5758"
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/dex/.dexc"
        }
      ]
    }
  ]
}
