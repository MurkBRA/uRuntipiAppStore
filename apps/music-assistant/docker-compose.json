{
  "schemaVersion": 2,
  "services": [
    {
      "name": "music-assistant",
      "image": "ghcr.io/music-assistant/server:2.10.7",
      "isMain": true,
      "internalPort": 8896,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "XDG_CACHE_HOME",
          "value": "/data/.cache"
        },
        {
          "key": "TORCH_HOME",
          "value": "/data/.cache/torch"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data/"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/downloads",
          "containerPath": "/media"
        }
      ],
      "capAdd": [
        "SYS_ADMIN",
        "DAC_READ_SEARCH"
      ],
      "securityOpt": [
        "apparmor=unconfined"
      ]
    }
  ]
}
