{
  "schemaVersion": 2,
  "services": [
    {
      "name": "stash",
      "image": "savewithstash/stash:1.0.1",
      "isMain": true,
      "internalPort": 5173,
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "PORT",
          "value": 5173
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/app/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/models",
          "containerPath": "/app/models"
        }
      ]
    }
  ]
}
