{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bluewallet",
      "image": "bluewalletorganization/lndhub:v1.4.1",
      "isMain": true,
      "internalPort": 3008,
      "addToMainNetwork": true,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "PORT",
          "value": 3008
        },
        {
          "key": "TOR_URL",
          "value": "${APP_DOMAIN}"
        },
        {
          "key": "LND_CERT_FILE",
          "value": "/lnd/tls.cert"
        },
        {
          "key": "LND_ADMIN_MACAROON_FILE",
          "value": "/lnd/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/admin.macaroon"
        },
        {
          "key": "CONFIG",
          "value": "{ \"rateLimit\": 10000, \"postRateLimit\": 10000, \"redis\": { \"port\": 6379, \"host\": \"bluewallet-redis\", \"family\": 4, \"password\": \"moneyprintergobrrr\", \"db\": 0 }, \"lnd\": { \"url\": \"${APP_LIGHTNING_NODE_IP}:${APP_LIGHTNING_NODE_GRPC_PORT}\", \"password\": \"\"}}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}",
          "containerPath": "/lnd",
          "readOnly": true
        }
      ],
      "dependsOn": [
        "bluewallet-redis"
      ]
    },
    {
      "name": "bluewallet-redis",
      "image": "redis:6.2.2-buster",
      "addToMainNetwork": true,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "command": "redis-server --requirepass moneyprintergobrrr",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/redis",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
