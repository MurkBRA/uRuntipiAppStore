{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bitboard",
      "image": "ghcr.io/egzola/bitboard:1.0.2",
      "isMain": true,
      "internalPort": 3711,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "PORT",
          "value": 3711
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
