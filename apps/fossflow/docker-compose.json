{
  "schemaVersion": 2,
  "services": [
    {
      "name": "fossflow",
      "image": "stnsmith/fossflow:master-b69fc2e",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "ENABLE_SERVER_STORAGE",
          "value": "true"
        },
        {
          "key": "STORAGE_PATH",
          "value": "/data/diagrams"
        },
        {
          "key": "ENABLE_GIT_BACKUP",
          "value": "false"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/diagrams",
          "containerPath": "/data/diagrams"
        }
      ]
    }
  ]
}
