{
  "schemaVersion": 2,
  "services": [
    {
      "name": "enclosed",
      "image": "corentinth/enclosed:1.16.0-rootless",
      "isMain": true,
      "internalPort": 8787,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/.data"
        }
      ]
    }
  ]
}
