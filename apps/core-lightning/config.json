      "env_variable": "APP_BITCOIN_NETWORK"
    },
    {
      "type": "text",
      "label": "Bitcoin Node Host / IP",
      "required": false,
      "default": "bitcoind",
      "hint": "Hostname or IP of your Bitcoin RPC node on the Runtipi network",
      "env_variable": "APP_BITCOIN_NODE_IP"
    },
    {
      "type": "text",
      "label": "Bitcoin RPC Username",
      "required": false,
      "default": "umbrel",
      "env_variable": "APP_BITCOIN_RPC_USER"
    },
    {
      "type": "password",
      "label": "Bitcoin RPC Password",
      "required": false,
      "default": "moneyprintergobrrr",
      "env_variable": "APP_BITCOIN_RPC_PASS"
    },
    {
      "type": "number",
      "label": "Bitcoin RPC Port",
      "required": false,
      "default": 8332,
      "env_variable": "APP_BITCOIN_RPC_PORT"
    },
    {
      "type": "text",
      "label": "Tor SOCKS Proxy Host / IP (Optional)",
      "required": false,
      "default": "127.0.0.1",
      "env_variable": "TOR_PROXY_IP"
    },
    {
      "type": "number",
      "label": "Tor SOCKS Proxy Port (Optional)",
      "required": false,
      "default": 9050,
      "env_variable": "TOR_PROXY_PORT"
    },
    {
      "type": "random",
      "label": "Tor Control Password",
      "min": 32,
      "env_variable": "TOR_PASSWORD"
    }
  ],
  "supported_architectures": [
