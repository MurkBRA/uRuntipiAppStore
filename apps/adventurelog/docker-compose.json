{
  "schemaVersion": 2,
  "services": [
    {
      "name": "adventurelog",
      "image": "ghcr.io/seanmorley15/adventurelog-frontend:v0.13.0",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "PUBLIC_SERVER_URL",
          "value": "http://adventurelogserver1:8000"
        },
        {
          "key": "ORIGIN",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "BODY_SIZE_LIMIT",
          "value": "Infinity"
        }
      ],
      "dependsOn": [
        "adventurelog-server"
      ]
    },
    {
      "name": "adventurelog-db",
      "image": "ghcr.io/baosystems/postgis:15-3.5",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "database"
        },
        {
          "key": "POSTGRES_USER",
          "value": "adventure"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "adventure"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/var/lib/postgresql/data/"
        }
      ]
    },
    {
      "name": "adventurelog-server",
      "image": "ghcr.io/seanmorley15/adventurelog-backend:v0.13.0",
      "environment": [
        {
          "key": "PGHOST",
          "value": "adventurelog-db"
        },
        {
          "key": "PGDATABASE",
          "value": "database"
        },
        {
          "key": "PGUSER",
          "value": "adventure"
        },
        {
          "key": "PGPASSWORD",
          "value": "adventure"
        },
        {
          "key": "SECRET_KEY",
          "value": "adventure"
        },
        {
          "key": "DJANGO_ADMIN_USERNAME",
          "value": "admin"
        },
        {
          "key": "DJANGO_ADMIN_PASSWORD",
          "value": "admin"
        },
        {
          "key": "DJANGO_ADMIN_EMAIL",
          "value": "admin@example.com"
        },
        {
          "key": "PUBLIC_URL",
          "value": "http://${APP_DOMAIN}:8016"
        },
        {
          "key": "CSRF_TRUSTED_ORIGINS",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        },
        {
          "key": "DEBUG",
          "value": "False"
        },
        {
          "key": "FRONTEND_URL",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/code/media/"
        }
      ],
      "addPorts": [
        {
          "hostPort": 8016,
          "containerPort": 80,
          "tcp": true
        }
      ],
      "dependsOn": [
        "adventurelog-db"
      ]
    }
  ]
}
