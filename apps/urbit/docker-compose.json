{
  "schemaVersion": 2,
  "services": [
    {
      "name": "urbit",
      "image": "mopfelwinrux/urbit-umbrel:v4.6",
      "isMain": true,
      "internalPort": 8090,
      "environment": [
        {
          "key": "APP_PASSWORD",
          "value": "${APP_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/piers",
          "containerPath": "/data/piers"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/keys",
          "containerPath": "/data/keys"
        }
      ],
      "addPorts": [
        {
          "hostPort": 34343,
          "containerPort": 34343,
          "tcp": true
        }
      ]
    }
  ]
}
