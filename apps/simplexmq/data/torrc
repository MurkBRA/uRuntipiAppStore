# SOCKS proxy for the SMP server to forward messages to other .onion relays
SocksPort 0.0.0.0:9050
SocksPolicy accept 10.0.0.0/8
SocksPolicy accept 172.16.0.0/12
SocksPolicy accept 192.168.0.0/16
SocksPolicy reject *
DataDirectory /data
Log notice stdout

# SMP relay hidden service
HiddenServiceDir /data/smp
HiddenServicePort 5223 simplexmq:5223
# SimpleX clients will default to port 443 for SMP in a future release
HiddenServicePort 443 simplexmq:5223

# XFTP file server hidden service
HiddenServiceDir /data/xftp
HiddenServicePort 5443 simplexmq-xftp-server:5443
