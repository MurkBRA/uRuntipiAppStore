{
  "schemaVersion": 2,
  "services": [
    {
      "name": "bitwatch",
      "image": "ghcr.io/zapomatic/bitwatch:v1.8.0",
      "isMain": true,
      "internalPort": 3117,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/app/server/data"
        }
      ]
    }
  ]
}
