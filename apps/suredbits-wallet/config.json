  "uid": 1000,
  "gid": 1000,
  "form_fields": [
    {
      "type": "random",
      "label": "Suredbits Wallet p2p hidden service",
      "min": 32,
      "env_variable": "APP_SUREDBITS_WALLET_P2P_HIDDEN_SERVICE"
    },
    {
      "type": "text",
      "label": "Container User (UID:GID)",
      "hint": "Process user and group ID (UID:GID). Keep 1000:1000 unless custom host permissions are required.",
      "required": false,
      "default": "1000:1000",
      "regex": "^[0-9]+(:[0-9]+)?$",
      "pattern_error": "Must be a numeric UID:GID (e.g. 1000:1000) or numeric UID (e.g. 1000)",
      "env_variable": "APP_CONTAINER_USER"
    },
    {
      "type": "text",
      "label": "Tor SOCKS Proxy Host / IP (Optional)",
      "required": false,
      "default": "127.0.0.1",
      "env_variable": "TOR_PROXY_IP"
    },
    {
      "type": "number",
      "label": "Tor SOCKS Proxy Port (Optional)",
      "required": false,
      "default": 9050,
      "env_variable": "TOR_PROXY_PORT"
    },
    {
      "type": "random",
      "label": "Suredbits Wallet password",
      "min": 32,
      "env_variable": "APP_PASSWORD"
    },
    {
      "type": "text",
      "label": "Bitcoin Network",
      "required": false,
      "default": "mainnet",
      "hint": "Network mode for Bitcoin node (mainnet, testnet, signet, regtest)",
      "env_variable": "APP_BITCOIN_NETWORK"
    },
    {
      "type": "random",
      "label": "Suredbits Wallet seed",
      "min": 64,
      "encoding": "hex",
      "env_variable": "APP_SEED"
    },
    {
      "type": "text",
      "label": "Bitcoin Node Host / IP",
      "required": false,
      "default": "bitcoind",
      "hint": "Hostname or IP of your Bitcoin RPC node on the Runtipi network",
      "env_variable": "APP_BITCOIN_NODE_IP"
    },
    {
      "type": "number",
      "label": "Bitcoin RPC Port",
      "required": false,
      "default": 8332,
      "env_variable": "APP_BITCOIN_RPC_PORT"
    },
    {
      "type": "text",
      "label": "Bitcoin RPC Username",
      "required": false,
      "default": "umbrel",
      "env_variable": "APP_BITCOIN_RPC_USER"
    },
    {
      "type": "password",
      "label": "Bitcoin RPC Password",
      "required": false,
      "default": "moneyprintergobrrr",
      "env_variable": "APP_BITCOIN_RPC_PASS"
    }
  ],
