{
  "schemaVersion": 2,
  "services": [
    {
      "name": "jupyterlab",
      "image": "quay.io/jupyter/base-notebook:lab-4.6.4",
      "isMain": true,
      "internalPort": 8888,
      "user": "1000:1000",
      "command": "start-notebook.py --IdentityProvider.token=${APP_PASSWORD}",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/home/jovyan/work"
        }
      ]
    }
  ]
}
