{
  "schemaVersion": 2,
  "services": [
    {
      "name": "perplexica",
      "image": "itzcrazykns1337/vane:v1.12.2",
      "isMain": true,
      "internalPort": 3000,
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app_data",
          "containerPath": "/home/perplexica/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/uploads",
          "containerPath": "/home/perplexica/uploads"
        }
      ]
    }
  ]
}
