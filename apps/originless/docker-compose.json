{
  "schemaVersion": 2,
  "services": [
    {
      "name": "originless",
      "image": "ghcr.io/besoeasy/originless:0.1.0",
      "isMain": true,
      "internalPort": 3232,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "5m",
      "environment": [
        {
          "key": "NODE_ENV",
          "value": "production"
        },
        {
          "key": "STORAGE_MAX",
          "value": "${STORAGE_MAX}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ],
      "addPorts": [
        {
          "hostPort": 4003,
          "containerPort": 4001,
          "tcp": true
        },
        {
          "hostPort": 4003,
          "containerPort": 4001,
          "udp": true,
          "tcp": false
        }
      ]
    }
  ]
}
