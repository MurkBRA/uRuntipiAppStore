{
  "schemaVersion": 2,
  "services": [
    {
      "name": "swingmusic",
      "image": "ghcr.io/swingmx/swingmusic:v3.0.0",
      "isMain": true,
      "internalPort": 1970,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/music",
          "containerPath": "/music"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/downloads",
          "containerPath": "/downloads"
        }
      ]
    }
  ]
}
