{
  "schemaVersion": 2,
  "services": [
    {
      "name": "gitingest",
      "image": "ghcr.io/coderamp-labs/gitingest:v0.3.1",
      "isMain": true,
      "internalPort": 8000,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "ALLOWED_HOSTS",
          "value": "${APP_ALLOWED_HOSTS:-${APP_DOMAIN},${LOCAL_DOMAIN},${APP_HOST:-${INTERNAL_IP}},${INTERNAL_IP},localhost,${APP_DOMAIN}:${APP_PORT},${LOCAL_DOMAIN}:${APP_PORT},${INTERNAL_IP}:${APP_PORT}}"
        }
      ]
    }
  ]
}
