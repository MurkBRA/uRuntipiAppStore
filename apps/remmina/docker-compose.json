{
  "schemaVersion": 2,
  "services": [
    {
      "name": "remmina",
      "image": "linuxserver/remmina:1.4.35",
      "isMain": true,
      "internalPort": 3000,
      "environment": [
        {
          "key": "PUID",
          "value": "1000"
        },
        {
          "key": "PGID",
          "value": "1000"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/config"
        }
      ]
    }
  ]
}
