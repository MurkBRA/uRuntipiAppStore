{
  "schemaVersion": 2,
  "services": [
    {
      "name": "opencode",
      "image": "ghcr.io/anomalyco/opencode:1.19.3",
      "isMain": true,
      "internalPort": 4096,
      "user": "1000:1000",
      "command": [
        "serve",
        "--hostname",
        "0.0.0.0",
        "--port",
        "4096"
      ],
      "environment": [
        {
          "key": "HOME",
          "value": "/home/opencode"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/opencode",
          "containerPath": "/home/opencode/"
        }
      ]
    }
  ]
}
