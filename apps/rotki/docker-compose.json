{
  "schemaVersion": 2,
  "services": [
    {
      "name": "rotki",
      "image": "rotki/rotki:v1.44.1",
      "isMain": true,
      "internalPort": 80,
      "stopGracePeriod": "1m",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/data",
          "containerPath": "/data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/logs",
          "containerPath": "/logs"
        }
      ]
    }
  ]
}
