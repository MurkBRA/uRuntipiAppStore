{
  "name": "WoofBot (LND)",
  "available": true,
  "port": 21412,
  "exposable": true,
  "dynamic_config": true,
  "id": "woofbot-lnd",
  "description": "WoofBot is a chat bot that runs on your personal Bitcoin node and sends telegram notifications for configured events: payments from/to specified addresses, transactions being confirmed, new-blocks and more. This version of WoofBot integrates with LND lightning api. WoofBot is NOT affiliated with Lightning Labs, the creators of LND. WoofBot only communicates with LND's api.",
  "tipi_version": 1,
  "version": "v0.9.8",
  "categories": [
    "finance"
  ],
  "short_desc": "A chatbot for your personal node",
  "author": "WoofBotApp",
  "source": "https://github.com/woofbotapp/woofbotapp",
  "website": "https://github.com/woofbotapp",
  "uid": 1000,
  "gid": 1000,
  "form_fields": [
    {
      "type": "random",
      "label": "WoofBot (LND) seed",
      "min": 64,
      "encoding": "hex",
      "env_variable": "APP_SEED"
    },
    {
      "type": "text",
      "label": "Bitcoin Node Host / IP",
      "required": false,
      "default": "bitcoind",
      "hint": "Hostname or IP of your Bitcoin RPC node on the Runtipi network",
      "env_variable": "APP_BITCOIN_NODE_IP"
    },
    {
      "type": "text",
      "label": "Bitcoin RPC Username",
      "required": false,
      "default": "umbrel",
      "env_variable": "APP_BITCOIN_RPC_USER"
    },
    {
      "type": "password",
      "label": "Bitcoin RPC Password",
      "required": false,
      "default": "moneyprintergobrrr",
      "env_variable": "APP_BITCOIN_RPC_PASS"
    },
    {
      "type": "number",
      "label": "Bitcoin RPC Port",
      "required": false,
      "default": 8332,
      "env_variable": "APP_BITCOIN_RPC_PORT"
    },
    {
      "type": "text",
      "label": "Lightning (LND) Node Host / IP",
      "required": false,
      "default": "lightning",
      "env_variable": "APP_LIGHTNING_NODE_IP"
    },
    {
      "type": "number",
      "label": "Lightning (LND) gRPC Port",
      "required": false,
      "default": 10009,
      "env_variable": "APP_LIGHTNING_NODE_GRPC_PORT"
    },
    {
      "type": "text",
      "label": "Bitcoin Network",
      "required": false,
      "default": "mainnet",
      "hint": "Network mode for Bitcoin node (mainnet, testnet, signet, regtest)",
      "env_variable": "APP_BITCOIN_NETWORK"
    },
    {
      "type": "text",
      "label": "Lightning (LND) Data Directory",
      "required": false,
      "default": "/data/lnd",
      "env_variable": "APP_LIGHTNING_NODE_DATA_DIR"
    }
  ],
  "supported_architectures": [
    "arm64",
    "amd64"
  ],
  "created_at": 1792501513236,
  "updated_at": 1792501573236,
  "$schema": "../app-info-schema.json",
  "min_tipi_version": "4.7.0"
}
