{
  "schemaVersion": 2,
  "services": [
    {
      "name": "woofbot-lnd",
      "image": "woofbot/woofbot:v0.9.8",
      "isMain": true,
      "internalPort": 8080,
      "addToMainNetwork": true,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "MONGODB_URI",
          "value": "mongodb://woofbot-lnd-mongodb:27017/woofbot"
        },
        {
          "key": "APP_PORT",
          "value": "8080"
        },
        {
          "key": "APP_SEED",
          "value": "${APP_SEED}"
        },
        {
          "key": "APP_BITCOIN_NODE_IP",
          "value": "${APP_BITCOIN_NODE_IP}"
        },
        {
          "key": "APP_BITCOIN_RPC_USER",
          "value": "${APP_BITCOIN_RPC_USER}"
        },
        {
          "key": "APP_BITCOIN_RPC_PASS",
          "value": "${APP_BITCOIN_RPC_PASS}"
        },
        {
          "key": "APP_BITCOIN_RPC_PORT",
          "value": "${APP_BITCOIN_RPC_PORT}"
        },
        {
          "key": "APP_LIGHTNING_NODE_IP",
          "value": "${APP_LIGHTNING_NODE_IP}"
        },
        {
          "key": "APP_LIGHTNING_NODE_GRPC_PORT",
          "value": "${APP_LIGHTNING_NODE_GRPC_PORT}"
        },
        {
          "key": "LND_TLS_PATH",
          "value": "/lnd/tls.cert"
        },
        {
          "key": "LND_READONLY_MACAROON_PATH",
          "value": "/lnd/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/readonly.macaroon"
        },
        {
          "key": "SERVER_LOGS_FILEPATH",
          "value": "/app/logs/server.log"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/server-logs",
          "containerPath": "/app/logs"
        },
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}/tls.cert",
          "containerPath": "/lnd/tls.cert",
          "readOnly": true
        },
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/readonly.macaroon",
          "containerPath": "/lnd/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/readonly.macaroon",
          "readOnly": true
        }
      ],
      "dependsOn": [
        "woofbot-lnd-mongodb"
      ]
    },
    {
      "name": "woofbot-lnd-mongodb",
      "image": "mongo:4.4.6-bionic",
      "addToMainNetwork": true,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "stopGracePeriod": "1m",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/data/db"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/db/diagnostic.data",
          "containerPath": "/data/db/diagnostic.data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/db/journal",
          "containerPath": "/data/db/journal"
        }
      ]
    }
  ]
}
