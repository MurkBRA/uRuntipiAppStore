{
  "schemaVersion": 2,
  "services": [
    {
      "name": "agent-zero",
      "image": "agent0ai/agent-zero:v2.14",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "ALLOWED_ORIGINS",
          "value": "${APP_PROTOCOL:-http}://${APP_DOMAIN},http://${LOCAL_DOMAIN}:3015,${ips_with_port}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/usr",
          "containerPath": "/a0/usr"
        }
      ],
      "extraHosts": [
        "host.docker.internal:host-gateway"
      ]
    }
  ]
}
