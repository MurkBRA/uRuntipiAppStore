{
  "schemaVersion": 2,
  "services": [
    {
      "name": "domain-locker",
      "image": "lissy93/domain-locker:0.3.0",
      "isMain": true,
      "internalPort": 3000,
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "DL_ENV_TYPE",
          "value": "selfHosted"
        },
        {
          "key": "DL_PG_HOST",
          "value": "domain-locker-postgres"
        },
        {
          "key": "DL_PG_PORT",
          "value": 5432
        },
        {
          "key": "DL_PG_USER",
          "value": "postgres"
        },
        {
          "key": "DL_PG_PASSWORD",
          "value": "domain-locker"
        },
        {
          "key": "DL_PG_NAME",
          "value": "domain_locker"
        }
      ],
      "healthCheck": {
        "test": "wget --spider -q http://localhost:3000/api/health",
        "interval": "30s",
        "timeout": "10s",
        "retries": 3,
        "startPeriod": "40s"
      },
      "dependsOn": [
        "domain-locker-postgres"
      ]
    },
    {
      "name": "domain-locker-postgres",
      "image": "postgres:17.4",
      "user": "${APP_CONTAINER_USER:-1000:1000}",
      "environment": [
        {
          "key": "POSTGRES_DB",
          "value": "domain_locker"
        },
        {
          "key": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "domain-locker"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db_data",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "healthCheck": {
        "test": "pg_isready -U postgres -d domain_locker",
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    }
  ]
}
