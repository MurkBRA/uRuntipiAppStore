{
  "schemaVersion": 2,
  "services": [
    {
      "name": "appsmith",
      "image": "appsmith/appsmith-ce:v2.5.1",
      "isMain": true,
      "internalPort": 80,
      "environment": [
        {
          "key": "APPSMITH_ENCRYPTION_PASSWORD",
          "value": "${APP_PASSWORD}"
        },
        {
          "key": "APPSMITH_ENCRYPTION_SALT",
          "value": "${APP_PASSWORD}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/app",
          "containerPath": "/appsmith-stacks"
        }
      ]
    }
  ]
}
