{
  "schemaVersion": 2,
  "services": [
    {
      "name": "sparkkiosk",
      "image": "jensgertsen/sparkkiosk:v1.0.0",
      "isMain": true,
      "internalPort": 21214,
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "LND_GRPC_ENDPOINT",
          "value": "${APP_LIGHTNING_NODE_IP}"
        },
        {
          "key": "LND_GRPC_PORT",
          "value": "${APP_LIGHTNING_NODE_GRPC_PORT}"
        },
        {
          "key": "LND_GRPC_CERT",
          "value": "/lnd/tls.cert"
        },
        {
          "key": "LND_GRPC_MACAROON",
          "value": "/lnd/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/admin.macaroon"
        },
        {
          "key": "APP_HIDDEN_SERVICE",
          "value": "http://${APP_DOMAIN}"
        },
        {
          "key": "APP_PASSWORD",
          "value": "${APP_PASSWORD}"
        },
        {
          "key": "APP_DOMAIN",
          "value": "$APP_DOMAIN"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        },
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}",
          "containerPath": "/lnd",
          "readOnly": true
        }
      ]
    }
  ]
}
