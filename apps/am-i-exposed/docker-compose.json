{
  "schemaVersion": 2,
  "services": [
    {
      "name": "am-i-exposed",
      "image": "ghcr.io/copexit/am-i-exposed-umbrel:v0.43.1",
      "isMain": true,
      "internalPort": 8080,
      "addToMainNetwork": true,
      "user": "101:101",
      "stopGracePeriod": "30s",
      "environment": [
        {
          "key": "APP_MEMPOOL_IP",
          "value": "${APP_MEMPOOL_IP}"
        },
        {
          "key": "APP_MEMPOOL_PORT",
          "value": "${APP_MEMPOOL_PORT}"
        },
        {
          "key": "APP_MEMPOOL_HIDDEN_SERVICE",
          "value": "${APP_MEMPOOL_HIDDEN_SERVICE}"
        },
        {
          "key": "APP_TOR_PROXY_IP",
          "value": "tor-proxy"
        },
        {
          "key": "APP_TOR_PROXY_PORT",
          "value": "3001"
        }
      ],
      "healthCheck": {
        "test": "wget -qO- http://127.0.0.1:8080/health || exit 1",
        "interval": "30s",
        "timeout": "3s"
      },
      "dependsOn": [
        "am-i-exposed-tor-proxy"
      ]
    },
    {
      "name": "am-i-exposed-tor-proxy",
      "image": "ghcr.io/copexit/am-i-exposed-tor-proxy:v0.43.1",
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "10s",
      "environment": [
        {
          "key": "PORT",
          "value": "3001"
        },
        {
          "key": "TOR_PROXY_IP",
          "value": "${TOR_PROXY_IP}"
        },
        {
          "key": "TOR_PROXY_PORT",
          "value": "${TOR_PROXY_PORT}"
        }
      ]
    }
  ]
}
