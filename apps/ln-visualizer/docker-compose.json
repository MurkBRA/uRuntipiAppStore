{
  "schemaVersion": 2,
  "services": [
    {
      "name": "ln-visualizer",
      "image": "maxkotlan/ln-visualizer-web:v0.0.28",
      "isMain": true,
      "internalPort": 80,
      "addToMainNetwork": true,
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "LN_VISUALIZER_API_URL",
          "value": "http://ln-visualizer-api:5647"
        }
      ]
    },
    {
      "name": "ln-visualizer-api",
      "image": "maxkotlan/ln-visualizer-api:v0.0.28",
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "LND_CERT_FILE",
          "value": "/lnd/tls.cert"
        },
        {
          "key": "LND_MACAROON_FILE",
          "value": "/lnd/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/readonly.macaroon"
        },
        {
          "key": "LND_SOCKET",
          "value": "${APP_LIGHTNING_NODE_IP}:${APP_LIGHTNING_NODE_GRPC_PORT}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}/tls.cert",
          "containerPath": "/lnd/tls.cert",
          "readOnly": true
        },
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/readonly.macaroon",
          "containerPath": "/lnd/data/chain/bitcoin/${APP_BITCOIN_NETWORK}/readonly.macaroon",
          "readOnly": true
        }
      ]
    }
  ]
}
