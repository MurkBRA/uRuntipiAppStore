{
  "schemaVersion": 2,
  "services": [
    {
      "name": "woofbot",
      "image": "woofbot/woofbot:v0.9.8",
      "isMain": true,
      "internalPort": 8080,
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "MONGODB_URI",
          "value": "mongodb://woofbot-mongodb:27017/woofbot"
        },
        {
          "key": "APP_PORT",
          "value": "8080"
        },
        {
          "key": "APP_SEED",
          "value": "${APP_SEED}"
        },
        {
          "key": "APP_BITCOIN_NODE_IP",
          "value": "${APP_BITCOIN_NODE_IP}"
        },
        {
          "key": "APP_BITCOIN_RPC_USER",
          "value": "${APP_BITCOIN_RPC_USER}"
        },
        {
          "key": "APP_BITCOIN_RPC_PASS",
          "value": "${APP_BITCOIN_RPC_PASS}"
        },
        {
          "key": "APP_BITCOIN_RPC_PORT",
          "value": "${APP_BITCOIN_RPC_PORT}"
        },
        {
          "key": "SERVER_LOGS_FILEPATH",
          "value": "/app/logs/server.log"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/server-logs",
          "containerPath": "/app/logs"
        }
      ],
      "dependsOn": [
        "woofbot-mongodb"
      ]
    },
    {
      "name": "woofbot-mongodb",
      "image": "mongo:4.4.6-bionic",
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/db",
          "containerPath": "/data/db"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/db/diagnostic.data",
          "containerPath": "/data/db/diagnostic.data"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/db/journal",
          "containerPath": "/data/db/journal"
        }
      ]
    }
  ]
}
