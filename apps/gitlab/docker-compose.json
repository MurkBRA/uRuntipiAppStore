{
  "schemaVersion": 2,
  "services": [
    {
      "name": "gitlab",
      "image": "gitlab/gitlab-ce:19.5.1-ce.0",
      "isMain": true,
      "internalPort": 8929,
      "hostname": "gitlab",
      "shmSize": "256m",
      "ulimits": {
        "nofile": {
          "soft": 4096,
          "hard": 8192
        }
      },
      "environment": [
        {
          "key": "GITLAB_OMNIBUS_CONFIG",
          "value": "external_url '${APP_PROTOCOL:-http}://${APP_DOMAIN}:${APP_PORT:-8929}'\ngitlab_rails['initial_root_password'] = '${APP_PASSWORD}'\ngitlab_rails['gitlab_shell_ssh_port'] = 2424\nnginx['listen_port'] = 8929\nnginx['listen_https'] = false"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_DATA_DIR}/data/config",
          "containerPath": "/etc/gitlab"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/logs",
          "containerPath": "/var/log/gitlab"
        },
        {
          "hostPath": "${APP_DATA_DIR}/data/data",
          "containerPath": "/var/opt/gitlab"
        }
      ],
      "addPorts": [
        {
          "hostPort": 2424,
          "containerPort": 22,
          "tcp": true
        }
      ]
    }
  ]
}
