{
  "schemaVersion": 2,
  "services": [
    {
      "name": "thunderhub",
      "image": "apotdevin/thunderhub:0.19.0",
      "isMain": true,
      "internalPort": 3000,
      "addToMainNetwork": true,
      "user": "1000:1000",
      "stopGracePeriod": "1m",
      "environment": [
        {
          "key": "MASTER_PASSWORD_OVERRIDE",
          "value": "${APP_PASSWORD}"
        },
        {
          "key": "NO_VERSION_CHECK",
          "value": "true"
        },
        {
          "key": "LOG_LEVEL",
          "value": "debug"
        },
        {
          "key": "ACCOUNT_CONFIG_PATH",
          "value": "/data/thubConfig.yaml"
        },
        {
          "key": "YML_ENV_1",
          "value": "${APP_LIGHTNING_NODE_IP}:${APP_LIGHTNING_NODE_GRPC_PORT}"
        },
        {
          "key": "TOR_PROXY_SERVER",
          "value": "socks://${TOR_PROXY_IP}:${TOR_PROXY_PORT}"
        }
      ],
      "volumes": [
        {
          "hostPath": "${APP_LIGHTNING_NODE_DATA_DIR}",
          "containerPath": "/lnd",
          "readOnly": true
        },
        {
          "hostPath": "${APP_DATA_DIR}/data",
          "containerPath": "/data"
        }
      ]
    }
  ]
}
